<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/MyStyle.css" rel="stylesheet" />
    @await RenderSectionAsync("MyStyles", required: false)
</head>
<body>
    <div class="container">
        <header id="myheader"></header>
        <div class="row">
            <aside class="col-3 mycontent">
                #Menu
                <div class="card">
                    <div class="card-header">Danh mục</div>
                    <div class="card-body">
                        <ul class="list-group">
                            <li class="list-group-item">
                                <a href="#1">Điện thoại</a>
                            </li>
                            <li class="list-group-item">
                                <a href="#2">Máy tính bảng</a>
                            </li>
                            <li class="list-group-item">
                                <a href="#3">Laptop</a>
                            </li>
                        </ul>
                    </div>
                </div>
                
            </aside>
            <div class="col-9 mycontent">
                @RenderBody()
            </div>
        </div>
        <footer id="myfooter">Bản quyền....</footer>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    @await RenderSectionAsync("MyScripts", required: false)
</body>
</html>
