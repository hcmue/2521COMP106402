@model List<Category>

<div class="card">
    <div class="card-header">Danh mục</div>
    <div class="card-body">
        <ul class="list-group">
            @foreach (var item in Model)
            {
                <li class="list-group-item">
                    <a href="#@item.Id">@item.Name</a>
                </li>
            }
        </ul>
    </div>
</div>